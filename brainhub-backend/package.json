{
  "name": "brainhub-login",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "db:migrate:quest-api": "node --env-file=.env scripts/migrate-quest-api.js",
    "db:migrate:comments": "node --env-file=.env scripts/migrate-comments.js",
    "admin:create": "node --env-file=.env scripts/createAdmin.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "sanitize-html": "^2.13.0"
  },
  "description": "Etapa 1 do BrainHub: login e banco PostgreSQL",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11"
  }
}
